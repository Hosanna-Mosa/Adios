# Customer App - Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (required)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Maps API Key (required for maps to render)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Public website URL — used to build "share this dish/restaurant" links that work even for
# people who don't have the app installed yet (falls back to a web preview page there).
EXPO_PUBLIC_WEB_URL=https://your-frontend-domain.example.com

# QA ONLY — makes the app report this version to /auth/version-check instead of the real
# version in app.config.js, so the update gate can be exercised without building an old APK.
# Leave UNSET in real builds; the value is inlined at bundle time, so restart with
# `npx expo start -c` after changing it.
#   0.8.0 -> below minRequired  : blocking prompt, no "Maybe later"
#   0.9.5 -> below latest       : dismissible prompt with "Maybe later" (re-shown every launch
#                                 while the override is set, so it stays re-testable)
#   unset -> the built version  : no prompt
# EXPO_PUBLIC_VERSION_OVERRIDE=0.8.0
