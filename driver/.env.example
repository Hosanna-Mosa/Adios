# Driver App - Environment Variables
# Copy this file to .env and fill in your values

# Expo only bundles variables prefixed EXPO_PUBLIC_. Names like VITE_API_BASE_URL
# (used by admin/ and frontend/) are silently ignored here, and the app then
# falls back to http://localhost:3000/api/v1.

# Backend API URL (required). On a phone, use your computer's LAN IP and the
# backend's PORT (e.g. http://192.168.1.10:5000/api/v1) — "localhost" is the
# phone itself. Restart with `npx expo start --clear` after changing it.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Maps API Key (required for maps to render)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# DigiLocker
# Nothing to configure here on purpose. DigiLocker credentials live only on the
# backend (DIGILOCKER_* in backend/.env) — a client-side OAuth secret would be
# readable by anyone with the app installed. The app just calls
# /api/v1/digilocker/* and opens the consent URL the backend returns.

# Razorpay Configuration
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
