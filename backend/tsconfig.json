{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  // One-off maintenance scripts (never imported by the deployed server, run
  // manually via ts-node) shouldn't gate the real build on their own type
  // quirks — this excludes them from `tsc`'s project-wide check only; running
  // one directly (e.g. `ts-node src/scripts/foo.ts`) is unaffected.
  "exclude": ["node_modules", "**/*.spec.ts", "src/scripts/**/*"]
}
