# Backend - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MongoDB (the code reads DATABASE_URL — MONGODB_URI is not used, kept here as documentation of intent)
DATABASE_URL=mongodb://localhost:27017/projectx

# Redis (used for BullMQ queues and Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here

# CORS — comma-separated list of allowed web origins (admin dashboard, partner site).
# Mobile apps (app/driver) aren't affected by CORS. Leave unset in development to allow any origin.
# ALLOWED_ORIGINS=https://admin.yourdomain.com,https://partners.yourdomain.com

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret of the dashboard webhook pointing at /api/v1/payments/webhook (events: payment.captured,
# order.paid, refund.processed, refund.failed). Different for test and live mode. Unset = the
# webhook answers 503.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Public https URL of this API, used to build the checkout link the phone's browser opens.
# Needed behind a proxy/tunnel; otherwise it is derived from the request host.
# PUBLIC_API_URL=https://x-api.triozen.tech
# RazorpayX (driver/vendor payouts). While the account number is missing or a placeholder,
# cash-outs are only recorded as requested ("pending") — nothing is sent and nothing is ever
# reported as paid. Keys default to RAZORPAY_KEY_ID/SECRET when not set separately.
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_account_number
# RAZORPAYX_KEY_ID=
# RAZORPAYX_KEY_SECRET=
# Secret of the RazorpayX dashboard webhook pointing at /api/v1/payouts/webhook (payout.* events).
RAZORPAYX_WEBHOOK_SECRET=your_razorpayx_webhook_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Surepass (Aadhaar/PAN verification)
SURPASS_API_KEY=your_surpass_api_key
SURPASS_BASE_URL=https://api.surepass.io/v1

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Sender name shown in the inbox (defaults to "Adios").
EMAIL_FROM_NAME=Adios

# Public partner website (frontend/). Used for the "resubmit documents" link in
# the email a restaurant gets when an admin asks for documents again.
PARTNER_WEBSITE_URL=http://localhost:5173
# Vendor portal login page (admin/ app, /vendor-login route). The email a
# restaurant gets when it is approved has a "Log in to the vendor portal"
# button that opens this link. Use the deployed admin URL in production.
VENDOR_LOGIN_URL=http://localhost:8080/vendor-login
# Restaurant / meat-shop partner app link (Play Store, App Store or a download
# page). The approval email gets a "Get the Adios Partner app" button with it;
# leave empty until the link exists and the button is simply left out.
PARTNER_APP_URL=

# DigiLocker (driver KYC and restaurant-owner KYC via government-issued documents)
# Mode: "sandbox" runs the built-in simulator (no credentials needed, simulated
# documents); "live" talks to the real DigiLocker Partner API and REQUIRES real
# credentials below. Leave unset to auto-detect: placeholder credentials => sandbox.
DIGILOCKER_MODE=sandbox
DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret
# Partner OAuth2 base. MeriPehchaan is what current partner onboarding issues for.
DIGILOCKER_BASE_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1
# Must match the redirect URI registered with DigiLocker exactly.
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/v1/digilocker/callback
# Public origin of this backend; used to build the sandbox consent URL.
PUBLIC_BASE_URL=http://localhost:5000
# Optional fallback deep link for the callback page. Leave BLANK: the driver app
# sends its own per session (its scheme differs between dev and release builds),
# and a value here makes browser-based testing try to launch the mobile app.
DIGILOCKER_CLIENT_REDIRECT_URL=
# 32-byte hex or base64 key encrypting stored DigiLocker tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to a key derived from JWT_SECRET when unset.
DIGILOCKER_ENCRYPTION_KEY=
# Optional tuning (defaults shown)
# DIGILOCKER_SESSION_TTL_MINUTES=15
# DIGILOCKER_TOKEN_REFRESH_LEEWAY_SECONDS=120
# DIGILOCKER_REQUEST_TIMEOUT_MS=20000
# DIGILOCKER_RATE_LIMIT_MAX=30
# DIGILOCKER_SESSION_RATE_LIMIT_MAX=5

# Gemini OCR Key
GEMINI_API_KEY=your_gemini_api_key_here

# Web Push (browser notifications for the admin/support/vendor dashboard)
# Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@example.com

# Universal/App Links (lets shared https:// links open the app directly — see index.ts)
APPLE_TEAM_ID=your_apple_team_id
ANDROID_SHA256_FINGERPRINT=your_android_release_signing_sha256_fingerprint

# Pricing rates (all optional — pricing.service.ts falls back to the defaults shown below)
RATE_BIKE_BASE=15
RATE_BIKE_PER_KM=5
RATE_BIKE_PER_MIN=1
RATE_AUTO_BASE=25
RATE_AUTO_PER_KM=8
RATE_AUTO_PER_MIN=2
RATE_CAB_BASE=50
RATE_CAB_PER_KM=12
RATE_CAB_PER_MIN=3
RATE_CAB_PRIME_BASE=80
RATE_CAB_PRIME_PER_KM=18
RATE_CAB_PRIME_PER_MIN=4
RATE_DELIVERY_BASE=50
RATE_DELIVERY_PER_KM=12
RATE_DELIVERY_PER_MIN=2
RATE_HELPER_BASE=99
RATE_HELPER_PER_KM=15
RATE_HELPER_PER_MIN=2
