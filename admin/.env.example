# Admin Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (required)
VITE_API_URL=http://localhost:3000/api/v1

# Public partner-website URL used to build the digital-menu QR codes.
# Point this at the deployed frontend/ site; if unset, the admin falls back to
# its own origin, which is only correct when both are served from one domain.
VITE_FRONTEND_URL=http://localhost:5173

# DigiLocker Configuration
VITE_DIGILOCKER_CLIENT_ID=your_digilocker_client_id_here
VITE_DIGILOCKER_REDIRECT_URI=http://localhost:8080/verify-digilocker

# Web Push (browser notifications) — the public half of the backend's VAPID_PUBLIC_KEY.
# Safe to expose client-side; this is not the private key.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Firebase Analytics (GA4) — from the Firebase console: Project settings → Your apps →
# the admin Web app → SDK setup and configuration → Config. Leave any unset to disable
# analytics (e.g. in local dev). These are public client identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=flavour-71159.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flavour-71159
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
