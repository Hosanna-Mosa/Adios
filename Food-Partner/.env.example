# Food Partner App - Environment Variables
# Copy this file to .env and fill in your values. Values are inlined at bundle
# time, so restart with `npx expo start -c` after changing any of them.
# For EAS cloud builds set the same names as EAS environment variables
# (expo.dev → project → Environment variables) instead of committing them.

# Backend API URL (required) — same backend the customer/driver apps use.
# A plain http:// URL (a LAN backend) also allows cleartext traffic on Android;
# an https:// URL — production — builds with cleartext traffic disabled.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Partner support contact shown on the Help & support screen (optional — the
# call/email rows are hidden when unset)
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Partner website (optional) — opened when an application needs documents
# re-uploaded (/partner/resubmit) or a new partner wants to sign up (/partner)
EXPO_PUBLIC_PARTNER_WEB_URL=https://your-frontend-domain.example.com

# EAS project id — required for `eas build` AND for push notifications: without
# it the device gets no Expo push token, so new orders only alert while the app
# is open. (`eas init` prints it; set it as an EAS environment variable too.)
EAS_PROJECT_ID=

# Live Socket.IO updates (optional, off by default). The app polls the API for
# new orders, scheduled requests and support replies instead; set to "true" to
# also open the socket connection.
EXPO_PUBLIC_ENABLE_SOCKETS=
