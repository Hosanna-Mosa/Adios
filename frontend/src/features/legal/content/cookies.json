              ]
            ]
          },
          {
            "type": "p",
            "runs": [
              ["2.2 ", false],
              ["When it stops.", true],
              [
                " When you go offline, sign out, or revoke the permission.",
                false
              ]
            ]
          },
          {
            "type": "p",
            "runs": [
              ["2.3 ", false],
              ["Why it is necessary.", true],
              [
                " Without location while you are online, Adios cannot offer you nearby Jobs, show Customers where you are, or protect you and Customers in a safety incident.",
                false
              ]
            ]
          }
        ],
