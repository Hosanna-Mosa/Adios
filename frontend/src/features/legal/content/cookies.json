        "title": "1. What these technologies are",
        "blocks": [
          {
            "type": "li",
            "runs": [
              ["Cookies", true],
              [
                " are small text files that a website places in your web browser. They are used only on Adios web pages, not inside the mobile app.",
                false
              ]
            ]
          },
          {
            "type": "li",
            "runs": [
              ["On-device storage", true],
              [
                " (local storage, secure storage and app caches) lets the app remember information on your phone, such as the fact that you are signed in.",
                false
              ]
            ]
          },
          {
            "type": "li",
            "runs": [
              ["SDKs", true],
              [
                " are pieces of code from other companies that we build into the app to provide a function, such as maps, notifications or analytics. Some SDKs collect information about your device and how you use the app.",
                false
              ]
            ]
          },
          {
            "type": "li",
            "runs": [
              ["Identifiers", true],
              [
                " are values that recognise an app installation or device, such as a push-notification token, a Firebase app-instance ID or, on Android, the advertising ID.",
                false
              ]
            ]
          }
        ],
        "id": "1-what-these-technologies-are"
