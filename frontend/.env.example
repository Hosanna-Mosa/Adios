# Partner Website - Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (required). VITE_API_BASE_URL takes precedence over VITE_API_URL if both are set.
VITE_API_URL=http://localhost:3000/api/v1
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# Published privacy policy, linked from the site footer. Optional until it exists.
# VITE_PRIVACY_POLICY_URL=https://yourdomain.com/privacy

# Support inbox shown on /delete-account for people who can't sign in with a password. Optional.
# VITE_SUPPORT_EMAIL=support@yourdomain.com

# Google Maps (used by the vendor onboarding address picker)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
